# Machine-local data and credentials never belong in source control.
/runtime/
/platform-data/
/bin/
/dist/
/agent.yaml
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite*
**/registry.json
**/.credential-key
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/known_hosts
**/*.log
**/*.tar.gz
**/*.zip
**/.DS_Store
/web/dist/
/coverage/
/.worktrees/
