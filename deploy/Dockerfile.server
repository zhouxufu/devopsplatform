FROM golang:1.22-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /out/logserver ./cmd/server

FROM alpine:3.19
RUN adduser -D -u 10001 log
COPY --from=build /out/logserver /usr/local/bin/logserver
USER log
EXPOSE 9801
VOLUME /data
ENTRYPOINT ["logserver"]
CMD ["-addr", ":9801", "-data", "/data"]
